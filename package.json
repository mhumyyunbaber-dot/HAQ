{
  "name": "haq-legal-navigator",
  "version": "0.4.0",
  "private": true,
  "description": "Browser-private Pakistani legal-rights navigator: gateway, web, identity, legal-reference, PostgreSQL",
  "scripts": {
    "start": "node scripts/dev.cjs",
    "test": "node --test tests/auth.test.cjs tests/security-http.test.cjs tests/account-backup.test.cjs",
    "test:browser": "node scripts/browser-check.cjs",
    "scan:secrets": "python scripts/scan_secrets.py --history",
    "audit:dependencies": "npm audit --audit-level=high",
    "security": "npm run build && npm run scan:secrets && npm run audit:dependencies && npm test && npm run test:services && npm run test:browser:services && python -m unittest discover -s tests -p \"*_test.py\" && npm run backup:test",
    "build": "python build.py",
    "backup:test": "python scripts/backup.py --restore-test",
    "config:init": "node scripts/init-config.cjs",
    "db:migrate": "node scripts/migrate.cjs",
    "db:import": "node scripts/import-sqlite.cjs",
    "test:services": "node scripts/test-services.cjs",
    "test:browser:services": "node scripts/test-services.cjs --browser",
    "compose:check": "docker compose config --quiet"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "httpxy": "0.5.5",
    "jose": "6.2.13",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
