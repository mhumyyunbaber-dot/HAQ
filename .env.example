# Docker Compose configuration. Generate private values with npm run config:init.
# Never commit .env. For native processes use: npm run config:init -- --native
NODE_ENV=production
APP_ENV=preview
PORT=3000
# Compose publishes only gateway on this host address. Use 127.0.0.1 behind local TLS.
GATEWAY_BIND=127.0.0.1
ALLOWED_ORIGINS=
TRUSTED_PROXIES=
RATE_WINDOW_MS=60000
RATE_LIMIT_MAX=240
SECURITY_LOG_KEY=

# Three distinct gateway-to-service credentials (generated; never sent to browsers).
WEB_SERVICE_KEY=
IDENTITY_SERVICE_KEY=
LEGAL_SERVICE_KEY=
WEB_URL=http://web:3101
IDENTITY_URL=http://identity:3102
LEGAL_URL=http://legal:3103

# PostgreSQL administrative connection is for one-shot migrations/import/backups ONLY.
# Runtime identity is a separate DML-only role; other services receive NO database URL.
POSTGRES_PASSWORD=
IDENTITY_DB_PASSWORD=
DATABASE_ADMIN_URL=
AUTH_DATABASE_URL=

AUTH_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Separately managed 32-byte base64 key; do not store in the same place as backups.
AUTH_BACKUP_KEY=
